aws_region   = "us-east-1"
project_name = "cloud-lab-04"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

app_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.11.0/24"
]

db_subnet_cidrs = [
  "10.0.20.0/24",
  "10.0.21.0/24"
]

instance_type    = "t3.micro"
root_volume_size = 20

asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4

db_instance_class      = "db.t3.micro"
db_name                = "cloudlab04"
db_username            = "dbadmin"
backup_retention_period = 1

notification_email = "bremer17_5@hotmail.com"
